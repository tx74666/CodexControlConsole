{
  "manifest_version": 3,
  "name": "Codex Console · 普通 Chat 转发",
  "version": "0.1.1",
  "key": "",
  "description": "默认停用。仅在明确批准后，使用专用 ChatGPT 页面处理 Console 已确认请求。",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_title": "Console Chat 转发", "default_popup": "popup.html"},
  "options_ui": {"page": "popup.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["lib/protocol.js", "content-script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
